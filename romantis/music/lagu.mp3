<?php include 'koneksi.php'; ?>
<!DOCTYPE html>
<html>
<head>
    <title>Aplikasi Kantin</title>

    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">

    <div class="card shadow p-4">
        <h2 class="text-center mb-4">🍽️ APLIKASI KANTIN</h2>

        <div class="text-center mb-4">
            <a href="tambah_siswa.php" class="btn btn-primary">Tambah Siswa</a>
            <a href="tambah_menu.php" class="btn btn-success">Tambah Menu</a>
            <a href="tambah_transaksi.php" class="btn btn-warning">Tambah Transaksi</a>
        </div>

        <h4 class="mb-3">Data Transaksi</h4>

        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>No</th>
                    <th>Nama Siswa</th>
                    <th>Menu</th>
                    <th>Tanggal</th>
                    <th>Total</th>
                </tr>
            </thead>

            <tbody>
            <?php
            $no = 1;
            $data = mysqli_query($conn, "
            SELECT siswa.nama, menu.nama_menu, transaksi.tanggal, transaksi.total_bayar
            FROM transaksi
            JOIN siswa ON transaksi.id_siswa = siswa.id_siswa
            JOIN menu ON transaksi.id_menu = menu.id_menu
            ");

            while($d = mysqli_fetch_array($data)){
            ?>
                <tr>
                    <td><?= $no++ ?></td>
                    <td><?= $d['nama'] ?></td>
                    <td><?= $d['nama_menu'] ?></td>
                    <td><?= $d['tanggal'] ?></td>
                    <td>Rp <?= number_format($d['total_bayar'],0,',','.') ?></td>
                </tr>
            <?php } ?>
            </tbody>

        </table>

    </div>

</div>

</body>
</html>